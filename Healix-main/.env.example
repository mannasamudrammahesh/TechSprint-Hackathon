# Supabase Configuration (for authentication AND data storage)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API Key for AI chat responses
GOOGLE_API_KEY=your_google_gemini_api_key
GEMINI_API_KEY=your_google_gemini_api_key

# Python Backend URL for AI Models (DialogGPT, Whisper, TTS)
PYTHON_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Email Service (for Contact Us form)
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL=your_contact_email@example.com
