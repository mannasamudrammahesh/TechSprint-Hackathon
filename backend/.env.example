# Mental Health AI API Configuration
# Copy this file to .env and fill in your API keys

# Google Gemini API Key (Primary for unique mental health issues)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyAb1yzl6WvFy23zj-U7eijpRKChHhD8IEc

# OpenAI API Key (Backup for mental health responses)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face API Token (For specialized mental health models)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Database Configuration
DATABASE_URL=sqlite:///./healix_sessions.db

# Security
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Model Configuration
ENABLE_GPU=True
MODEL_CACHE_DIR=./model_cache

# Mental Health AI Configuration
ENABLE_CRISIS_DETECTION=True
ENABLE_EMOTION_ANALYSIS=True
ENABLE_API_FALLBACK=True
MAX_RESPONSE_LENGTH=500
CONFIDENCE_THRESHOLD=0.3

# Language Support
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,te,ta,kn,gu

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/healix.log

# Rate Limiting
RATE_LIMIT_ENABLED=True
REQUESTS_PER_MINUTE=60

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_HISTORY_LENGTH=20
